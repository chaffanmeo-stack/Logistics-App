# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# IMPORTANT: this must be the service_role key, not the anon key.
# This backend enforces access control itself, so it needs full DB access.
# NEVER expose this key to the browser or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Random long string used to sign session cookies. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-this-to-a-random-value

# Hub codes this instance serves (comma separated) — used for dropdowns/validation
HUBS=BWP,Multan,Lahore,Lodhran,RYK
